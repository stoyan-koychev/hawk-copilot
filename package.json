{
  "name": "@hawk/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Hawk Copilot agent: hybrid RAG + tool-use loop over Payhawk docs.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "openai": "^4.104.0",
    "pg": "^8.22.0"
  },
  "scripts": {
    "chat": "tsx src/main.ts",
    "test": "vitest run evals/deterministic",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src evals",
    "format": "biome format --write src evals",
    "ab": "tsx src/ops/ab.ts",
    "eval:judge": "vitest run evals/judge",
    "gate": "tsx src/ops/release-gate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
